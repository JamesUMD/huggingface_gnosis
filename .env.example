# Copy this to `.env` and fill in your real key. Any of the three names work
# — the agent factory falls back across them.

STRANDS_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...

# Optional: override the model the orchestrator + specialists use.
# STRANDS_MODEL_ID=claude-sonnet-4-6
